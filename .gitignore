# macOS clutter
.DS_Store
**/.DS_Store

# Obsidian workspace state, if you browse this folder with Obsidian.
# Vault settings, plugins, themes and snippets are worth keeping tracked;
# only the pane-layout scratch state gets rewritten on every window move.
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Identity and financial documents. These should not live in this workspace
# at all (reference them by path from wherever they actually live instead),
# but this is a backstop in case one lands here anyway. Adjust the patterns
# below for whatever document types apply where you live.
*passport*
*aadhaar*
*aadhar*
# Matched only as a separate word in the name, so an ordinary file such as
# classnotes.md is not hidden by accident.
ssn[-_.]*
*[-_]ssn[-_.]*
*social-security*
*bank-statement*
*paystub*
*pay-slip*
*salary-slip*
*specimen-signature*

# Backups taken before editing files (see Governance Rules). Kept on disk only,
# since a backup can hold text that was removed on purpose.
.backups/

# Python caches from any helper script
__pycache__/
*.pyc

# Per-computer AI tool settings and temporary agent worktrees, not workspace content
.claude/settings.local.json
.claude/worktrees/
